# Supabase — stores leads submitted through the eligibility check.
# In your Supabase project: Project Settings -> Data API (or "API") page.
# SUPABASE_URL is the "Project URL" shown there.
# SUPABASE_SERVICE_ROLE_KEY must be the SECRET key (full access, bypasses Row
# Level Security, server-only) — NOT the publishable/anon key, which respects
# RLS and will fail with "Could not find the table" errors since the `leads`
# table has RLS enabled with no public policies.
# Older Supabase projects show this as "service_role" (a long JWT).
# Newer Supabase projects show this as "SUPABASE_SECRET_KEY", starting with
# sb_secret_ — click the eye icon to reveal it. Either one goes here.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — sends the "here are your IES details" follow-up email.
# https://resend.com/api-keys
RESEND_API_KEY=
# Must be a verified sending domain/address, or the Resend sandbox default below.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Without these three, the site still runs fully: the quiz and UI work,
# and POST /api/lead just logs a warning and skips persistence/email.

# Admin panel (/admin) — a single shared password, no user accounts.
# Leave unset to keep /admin locked out entirely.
ADMIN_PASSWORD=
